# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.venv-native/
build/
dist/
*.spec
# Except the maintained sidecar spec (see build_sidecar.ps1) — it needs to be checked
# in since it's hand-edited to strip a stale bundled MSVCP140.dll, not auto-regenerated.
!vext-backend.spec
!vext-host32.spec
# The 32-bit Python the 32-bit plugin host runs on (tools/setup_x86_host.ps1)
.python-x86/

# Local application state. Normally in %APPDATA%\com.vext.app; these only
# appear in the repo when VEXT_ROOT points here (dev runs).
/data/
/cache/
/images/
logs/
*.log

# Docker and local environment overrides
.env
.env.*
!.env.example

# Node / Tauri
node_modules/
desktop/dist-mirror/
desktop/src-tauri/target/
desktop/src-tauri/*.local.json
desktop/src-tauri/binaries/
# The 32-bit plugin host, built by tools/build_host32.ps1
desktop/src-tauri/host32/
# Microsoft runtime installers shipped in the installer (tools/fetch_redist.ps1)
desktop/src-tauri/redist/
desktop/src-tauri/webview2/
# Rewritten by tauri-build on every build (from tauri.conf.json, capabilities/
# and the command list in build.rs)
desktop/src-tauri/gen/schemas/
desktop/src-tauri/permissions/autogenerated/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local agent/tool state and backups
.claude/
.playwright-mcp/
.freebuff/
.git-removed-backup-*/

# Generated export (lives in %APPDATA%\com.vext.app)
DATABASE.md

# Built installers (build_release.ps1 output)
release/

# Clean-PC test output (tools/sandbox/run.ps1)
tools/sandbox/results/
tools/sandbox/diag/

# Graphify output
graphify-out/
.venv-dev/

# Scratch output of audits and scripts
.scratch/

# Private development log (full AGENTS.md history; machine details)
notes/

# Kept by the maintainer, not published
sources/logo.vectorcraft
sources/Gemini_Generated_Image_*
